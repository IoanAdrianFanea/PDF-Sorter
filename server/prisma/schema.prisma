// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fullName     String?
  language     String?
  timezone     String?
  mustChangePassword Boolean @default(false)
  emailVerifiedAt    DateTime?
  emailVerificationToken String?  // SHA-256 hash of the raw token sent in the email

  uploadedDocuments Document[]        @relation("UploadedBy")
  projectMemberships ProjectMembership[]
  refreshTokens RefreshToken[]
  deletionLogs  DeletionLog[]  @relation("DeletedBy")
  accountStatus  AccountStatus  @default(PENDING)
}

model Project {
  id          String              @id @default(cuid())
  name        String              @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  memberships ProjectMembership[]
  documents   Document[]
}

model ProjectMembership {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String   // hash of the refresh token (never store plaintext)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Document {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User           @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime       @default(now())
  status           DocumentStatus
  errorMessage     String?
  deletedAt        DateTime?

  text             DocumentText?

  @@index([projectId])
  @@index([uploadedById])
  @@index([deletedAt])
}

/// Audit trail for document deletions.
/// `documentId` is intentionally a plain string, not a foreign key: the log row must
/// survive the permanent purge of the document it describes. Enough context is
/// denormalised (filename, project name, actor email) that the row stays readable
/// after the Document — or even the actor's account — is gone.
model DeletionLog {
  id                   String    @id @default(cuid())
  documentId           String
  projectId            String
  projectName          String
  originalFilename     String
  storageKey           String
  actorId              String?
  actor                User?     @relation("DeletedBy", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail           String
  deletedAt            DateTime  @default(now())
  restoredAt           DateTime?
  permanentlyDeletedAt DateTime?

  @@index([documentId])
  @@index([projectId])
  @@index([actorId])
  @@index([deletedAt])
}

model DocumentText {
  documentId    String   @id
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractedText String
  pageCount     Int?
  extractedAt   DateTime @default(now())
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}